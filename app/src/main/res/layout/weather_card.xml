<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Trackr.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_sm"
        android:paddingVertical="@dimen/spacing_xs">

        <ImageView
            android:id="@+id/imageWeatherIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            app:tint="?attr/colorPrimary"
            tools:src="@drawable/ic_sunny" />

        <TextView
            android:id="@+id/textWeatherTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:textAppearance="@style/TextAppearance.Trackr.Body"
            android:textStyle="bold"
            tools:text="18°C" />

        <TextView
            android:id="@+id/textWeatherCondition"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Trackr.BodyMuted"
            tools:text="Clear" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
